# Khong commit cookie that vao Git.
# Chon mot trong cac bien sau khi trien khai:
# FB_COOKIE=c_user=...; xs=...; fr=...
# FB_APPSTATE=[{"key":"c_user","value":"...","domain":"facebook.com","path":"/"}]
# FB_AUTH_FILE=/absolute/path/to/cookie.txt

# Dat key Groq trong Replit Secrets hoac Render Environment Variables.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=600

# API monitor dung HTTPS cua Replit/Render proxy ben ngoai.
# Endpoint cong khai: /healthz
# Endpoint bao mat: /api/status va /api/logs
MONITOR_API_KEY=
MONITOR_CONSOLE_LOGS=false
LOG_TTL_MS=300000
LOG_CLEANUP_INTERVAL_MS=300000
LOG_MAX_ITEMS=2000

# So lan lenh rs duoc phep khoi dong lai bot lien tiep.
BOT_MAX_RESTARTS=5

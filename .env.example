# Không commit cookie thật vào Git.
# Chọn một trong các biến sau khi triển khai:
# FB_COOKIE=c_user=...; xs=...; fr=...
# FB_APPSTATE=[{"key":"c_user","value":"...","domain":"facebook.com","path":"/"}]
# FB_AUTH_FILE=/absolute/path/to/cookie.txt

# Số lần lệnh rs được phép khởi động lại bot liên tiếp.
BOT_MAX_RESTARTS=5

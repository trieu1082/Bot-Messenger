{
  "FCAOption": {
    "forceLogin": true,
    "listenEvents": true,
    "updatePresence": false,
    "listenTyping": false,
    "logLevel": "error",
    "selfListen": false,
    "selfListenEvent": false,
    "autoMarkDelivery": false,
    "autoReconnect": true,
    "emitReady": true
  },
  "language": "vi",
  "DeveloperMode": false,
  "autoCreateDB": true,
  "allowInbox": true,
  "approvalMode": false,
